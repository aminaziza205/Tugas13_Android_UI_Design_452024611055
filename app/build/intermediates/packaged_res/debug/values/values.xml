<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background_dark">#1C1B1F</color>
    <color name="background_light">#FFFBFE</color>
    <color name="black">#000000</color>
    <color name="error_red">#B3261E</color>
    <color name="on_surface_dark">#E6E1E5</color>
    <color name="on_surface_light">#1C1B1F</color>
    <color name="purple_200">#D0BCFF</color>
    <color name="purple_500">#6650a4</color>
    <color name="purple_700">#4a3880</color>
    <color name="surface_dark">#2B2930</color>
    <color name="teal_200">#B2DFDB</color>
    <color name="teal_500">#03A9A4</color>
    <color name="teal_700">#00796B</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Lesson 13 UI Design</string>
    <string name="btn_save_text">Save Profile</string>
    <string name="desc_fab">Add new entry</string>
    <string name="error_email_invalid">Invalid email format</string>
    <string name="error_name_empty">Name cannot be empty</string>
    <string name="hint_email">example@email.com</string>
    <string name="hint_name">Enter your name</string>
    <string name="label_email">Email Address</string>
    <string name="label_name">Full Name</string>
    <string name="nav_home">Home</string>
    <string name="nav_profile">Profile</string>
    <string name="nav_settings">Settings</string>
    <string name="snackbar_action_undo">UNDO</string>
    <string name="snackbar_saved">Profile saved successfully!</string>
    <string name="toolbar_title">My Profile</string>
    <string name="welcome_subtitle">Please complete your profile below</string>
    <string name="welcome_title">Welcome!</string>
    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.App.Headline1" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>
    <style name="TextAppearance.App.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Theme.Tugas13UIDesign" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorSecondary">@color/teal_500</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>

        
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorError">@color/error_red</item>

        
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>

        
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
    </style>
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <style name="Widget.App.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="contentPadding">16dp</item>
    </style>
    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/purple_500</item>
    </style>
    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextAppearance">@style/TextAppearance.App.Headline1</item>
    </style>
</resources>